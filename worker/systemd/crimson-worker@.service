[Unit]
Description=Crimson worker (SYSNO %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/crimson/src
EnvironmentFile=/home/ubuntu/.crimson_env.systemd
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/ubuntu/crimson/src/recv.py %i 1
Restart=always
RestartSec=10
# Several instances share a VM with Ollama (~11 GB) and no swap. Chromium started
# by recv.py stays in this unit's cgroup, even when orphaned, so a leaking or
# runaway instance is OOM-killed and restarted clean here instead of the kernel
# picking Ollama. recv.py plus a live Chromium peaked around 1.75 GB.
MemoryMax=3G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crimson-worker-%i

[Install]
WantedBy=multi-user.target
