[Unit]
Description=Crimson authenticated crawler (feeder + one crawl pass)
Documentation=https://github.com/ja963mes/Crimson
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/crimson/src/authentication_crawling
# MAILINATOR_DOMAIN and MAILINATOR_API_KEY for sign-up emails and confirmation
# links (crawler_script.py skips the email step when they are missing).
EnvironmentFile=/home/ubuntu/.crimson_env.systemd
Environment="PYTHONUNBUFFERED=1"
# Each VM crawls the scams its own worker confirmed. feeder.py expands the glob
# itself and only appends new domains to urls.txt, so the crawler's resume
# checkpoint (crawled_urls.txt) stays valid between runs.
ExecStartPre=/usr/bin/python3 feeder.py --results /home/ubuntu/crimson/src/results/*/results.log.*
# One pass over urls.txt; the crawler logs to logs/logfile.log next to itself.
ExecStart=/usr/bin/python3 crawler_script.py
TimeoutStartSec=0
